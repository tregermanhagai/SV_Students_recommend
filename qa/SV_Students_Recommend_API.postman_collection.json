    {
      "name": "Team 2 - Recommendations",
      "description": "Create and validate a recommendation using the shared student token.",
      "item": [
        {
          "name": "List Recommendations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/recommendations?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function assertRecommendation(item) {",
                  "    pm.expect(item.id).to.be.a('string');",
                  "    pm.expect(item.name).to.be.a('string');",
                  "    pm.expect(item.category).to.be.a('string');",
                  "    pm.expect(item).to.have.property('description');",
                  "    pm.expect(item).to.have.property('image_url');",
                  "    pm.expect(item).to.have.property('website_link');",
                  "    pm.expect(item.recommender_name).to.be.a('string');",
                  "    pm.expect(item).to.have.property('created_by');",
                  "    pm.expect(item.created_at).to.be.a('string');",
                  "    pm.expect(item.updated_at).to.be.a('string');",
                  "    pm.expect(item.comment_count).to.be.a('number');",
                  "}",
                  "",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('List response is an array of recommendation objects', function () {",
                  "    pm.expect(json).to.be.an('array');",
                  "    json.forEach(assertRecommendation);",
                  "});"
                ]
              }
            }
          ]
        },
