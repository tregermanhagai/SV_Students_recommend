{
  "info": {
    "name": "SV Students Recommend API QA",
    "_postman_id": "b12f0f01-6a68-41c7-b0f6-c25e2ea87c6d",
    "description": "Team-based QA collection for the SV Students Recommend API. Each folder maps to one QA team and includes JSON response validation tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sv-students-recommend.onrender.com"
    }
  ],
  "item": [
    {
      "name": "Team 1 - Auth Foundation",
      "description": "Create a disposable user, log in, and prepare shared variables for the other teams.",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{studentName}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a disposable student account for the shared QA flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response JSON matches UserOut shape', function () {",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.email).to.be.a('string').and.includes('@');",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "});",
                  "",
                  "pm.environment.set('studentUserId', json.id);",
                  "pm.environment.set('studentEmail', json.email);",
                  "pm.environment.set('accessToken', json.access_token || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Login returns UserOut shape', function () {",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.email).to.eql(pm.environment.get('studentEmail'));",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('studentUserId', json.id);",
                  "pm.environment.set('accessToken', json.access_token);"
                ]
              }
            }
          ]
        },
