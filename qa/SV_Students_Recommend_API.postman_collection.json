                  "    pm.expect(json.recommender_name).to.eql(pm.environment.get('recommenderName'));",
                  "    pm.expect(json.comment_count).to.be.a('number');",
                  "    pm.expect(json.created_at).to.be.a('string');",
                  "    pm.expect(json.updated_at).to.be.a('string');",
                  "});",
                  "",
                  "pm.environment.set('recommendationId', json.id);"
