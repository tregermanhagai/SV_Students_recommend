                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "{{recommendationDescription}}",
                  "type": "text"
                },
                {
                  "key": "recommender_name",
                  "value": "{{recommenderName}}",
                  "type": "text"
                },
                {
                  "key": "website_link",
                  "value": "{{websiteLink}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations"
              ]
